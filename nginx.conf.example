# ==========================================================
# Nginx Configuration for FileTransfer Pro v2
# Copy this to: /etc/nginx/sites-available/filetransfer
# ==========================================================

server {
    listen 80;
    server_name your-domain.com www.your-domain.com; # Or your VPS IP address

    # CRITICAL: Allow up to 50 GB file uploads (Nginx default is only 1MB!)
    client_max_body_size 50G;

    # Timeouts for large file transfers
    proxy_connect_timeout 3600;
    proxy_send_timeout 3600;
    proxy_read_timeout 3600;
    send_timeout 3600;

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;

        # WebSocket support (Crucial for Socket.IO real-time features)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
