NODE_ENV=development
PORT=5000

# Optional: Remote MongoDB Atlas (Leave disabled for 100% offline LAN mode)
ENABLE_MONGODB=false
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/filetransferpro?retryWrites=true&w=majority

# JWT & Security
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
BCRYPT_ROUNDS=12

# Client URL
CLIENT_URL=http://localhost:5000
